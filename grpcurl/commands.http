proto < ../proto/usr.proto

### ConfReload
GRPC localhost:50051/requestsautomation.User/ConfReload
{
    "id": "default"
}

### CheckCon
GRPC localhost:50051/requestsautomation.User/CheckCon
{
    "id": "default"
}

### GenList (Combined URL Filters - CSV Persistence Mode)
GRPC localhost:50051/requestsautomation.User/GenList
{
    "urlget": "/te?q=123+eq+123 AND ",
    "urlfilter": {
        "aa::bb::cc": {
            "values": ["AA", "BB", "CC"]
        },
        "ggggg": {
            "values": ["aa", "bb", "cc"]
        }
    },
    "mode": "file"
}

### GenList (Combined URL Filters - SurrealDB Persistence Mode)
GRPC localhost:50051/requestsautomation.User/GenList
{
    "urlget": "/te?q=123+eq+123 AND ",
    "urlfilter": {
        "aa::bb::cc": {
            "values": ["AA", "BB"]
        }
    },
    "mode": "db"
}

### GenList (Direct Return Mode via gRPC)
GRPC localhost:50051/requestsautomation.User/GenList
{
    "urlget": "",
    "urlfilter": {
        "Objects.Name": {
            "values": ["AAccount"]
        }
    },
    "mode": "direct"
}

### ProvTasksList (Direct Return Mode with Custom Polars Filters & Sorting)
GRPC localhost:50051/requestsautomation.User/ProvTasksList
{
    "urlget": "/te?q=123+eq+123 AND ",
    "urlfilter": {
        "aa::bb::cc": {
            "values": ["AA", "BB"]
        }
    },
    "mode": "direct",
    "filter_object": "AAccount",
    "filter_task": "Update",
    "sort_descending": false
}

### ProvAction - Retry Tasks (from configured storage or specified mode)
GRPC localhost:50051/requestsautomation.User/ProvAction
{
    "action": "retry",
    "mode": "file"
}

### ProvAction - Manual Complete Tasks
GRPC localhost:50051/requestsautomation.User/ProvAction
{
    "action": "manual_complete",
    "mode": "file"
}

### ProvAction - Direct Task IDs (Retry or Manual Complete without CSV/DB)
GRPC localhost:50051/requestsautomation.User/ProvAction
{
    "action": "manual_complete",
    "mode": "direct",
    "task_ids": ["622483", "622484"]
}

### DbDelete
GRPC localhost:50051/requestsautomation.User/DbDelete
{
    "id": "default"
}
